{
	"schemaVersion": 1,
	"id": "securitycraft",
	"version": "${version}",
	"name": "SecurityCraft",
	"description": "Adds a load of things to keep your house safe with and defend yourself from attackers.",
	"authors": [
		"Geforce",
		"bl4ckscor3",
		"Redstone_Dubstep",
		"ChainmailPickaxe"
	],
	"contact": {
		"homepage": "https://discord.gg/U8DvBAW",
		"sources": "https://github.com/Geforce132/SecurityCraft",
		"issues": "https://github.com/Geforce132/SecurityCraft/issues"
	},
	"license": "MIT",
	"icon": "sc_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.geforcemods.securitycraft.SecurityCraft"
		],
		"client": [
			"net.geforcemods.securitycraft.SecurityCraftClient"
		]
	},
	"mixins": [
		"securitycraft.mixins.json",
		"securitycraft.platform.mixins.json"
	],
	"accessWidener": "securitycraft.accesswidener",
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_2248": ["net/geforcemods/securitycraft/platform/ext/SCBlockExtension"],
			"net/minecraft/class_2680": ["net/geforcemods/securitycraft/platform/ext/SCBlockStateExtension"],
			"net/minecraft/class_2586": ["net/geforcemods/securitycraft/platform/ext/SCBlockEntityExtension"],
			"net/minecraft/class_1792": ["net/geforcemods/securitycraft/platform/ext/SCItemExtension"],
			"net/minecraft/class_9322": ["net/geforcemods/securitycraft/platform/ext/SCDataComponentHolderExtension"],
			"net/minecraft/class_1799": ["net/geforcemods/securitycraft/platform/ext/SCItemStackExtension"],
			"net/minecraft/class_1792$class_1793": ["net/geforcemods/securitycraft/platform/ext/SCItemPropertiesExtension"],
			"net/minecraft/class_3908": ["net/geforcemods/securitycraft/platform/ext/SCMenuProviderExtension"],
			"net/minecraft/class_304": ["net/geforcemods/securitycraft/platform/ext/SCKeyMappingExtension"],
			"net/minecraft/class_1922": ["net/geforcemods/securitycraft/platform/ext/SCBlockGetterExtension"],
			"net/minecraft/class_339": ["net/geforcemods/securitycraft/platform/ext/SCAbstractWidgetExtension"]
		}
	},
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"forgeconfigapiport": "*"
	}
}
