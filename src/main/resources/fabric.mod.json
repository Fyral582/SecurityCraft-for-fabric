{
	"schemaVersion": 1,
	"id": "securitycraft",
	"version": "${version}",
	"name": "SecurityCraft",
	"description": "Adds a load of things to keep your house safe with and defend yourself from attackers.",
	"authors": [
		"Geforce",
		"bl4ckscor3",
		"Redstone_Dubstep",
		"ChainmailPickaxe"
	],
	"contact": {
		"homepage": "https://discord.gg/U8DvBAW",
		"sources": "https://github.com/Geforce132/SecurityCraft",
		"issues": "https://github.com/Geforce132/SecurityCraft/issues"
	},
	"license": "MIT",
	"icon": "sc_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.geforcemods.securitycraft.SecurityCraft"
		],
		"client": [
			"net.geforcemods.securitycraft.SecurityCraftClient"
		],
		"jei_mod_plugin": [
			"net.geforcemods.securitycraft.compat.jei.SCJEIPlugin"
		],
		"jade": [
			"net.geforcemods.securitycraft.compat.hudmods.JadeDataProvider"
		]
	},
	"mixins": [
		"securitycraft.mixins.json",
		"securitycraft.platform.mixins.json"
	],
	"accessWidener": "securitycraft.accesswidener",
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/world/level/block/Block": ["net/geforcemods/securitycraft/platform/ext/SCBlockExtension"],
			"net/minecraft/world/level/block/state/BlockState": ["net/geforcemods/securitycraft/platform/ext/SCBlockStateExtension"],
			"net/minecraft/world/level/block/entity/BlockEntity": ["net/geforcemods/securitycraft/platform/ext/SCBlockEntityExtension"],
			"net/minecraft/world/item/Item": ["net/geforcemods/securitycraft/platform/ext/SCItemExtension"],
			"net/minecraft/core/component/DataComponentHolder": ["net/geforcemods/securitycraft/platform/ext/SCDataComponentHolderExtension"],
			"net/minecraft/world/item/ItemStack": ["net/geforcemods/securitycraft/platform/ext/SCItemStackExtension"],
			"net/minecraft/world/item/Item$Properties": ["net/geforcemods/securitycraft/platform/ext/SCItemPropertiesExtension"],
			"net/minecraft/world/MenuProvider": ["net/geforcemods/securitycraft/platform/ext/SCMenuProviderExtension"],
			"net/minecraft/client/KeyMapping": ["net/geforcemods/securitycraft/platform/ext/SCKeyMappingExtension"],
			"net/minecraft/world/level/BlockGetter": ["net/geforcemods/securitycraft/platform/ext/SCBlockGetterExtension"],
			"net/minecraft/client/gui/components/AbstractWidget": ["net/geforcemods/securitycraft/platform/ext/SCAbstractWidgetExtension"],
			"net/minecraft/client/gui/components/EditBox": ["net/geforcemods/securitycraft/platform/ext/SCEditBoxExtension"]
		}
	},
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": ">=26.1 <26.2",
		"java": ">=25",
		"fabric-api": "*",
		"forgeconfigapiport": "*"
	}
}
